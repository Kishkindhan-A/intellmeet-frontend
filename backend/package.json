{
  "name": "intellmeet-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --config .prettierrc.json --write src tests scripts docs *.json *.yaml *.md ../.github/workflows/*.yml",
    "format:check": "prettier --config .prettierrc.json --check src tests scripts docs *.json *.yaml *.md ../.github/workflows/*.yml",
    "test:coverage": "vitest run --coverage",
    "docs:export": "tsx scripts/export-openapi.ts",
    "security:check": "npm audit --audit-level=high && npm run security:secrets && npm run check",
    "security:secrets": "secretlint \"src/**/*\" \"tests/**/*\" \"scripts/**/*\" \"docs/**/*\" \"*.json\" \"*.yaml\" \"../.github/**/*\"",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "local:start": "npm run build && node scripts/local-runtime.mjs",
    "local:stop": "node scripts/local-runtime.mjs --stop",
    "test:browser": "node scripts/browser-audit.mjs",
    "local:services": "npm run build && node scripts/local-runtime.mjs --services",
    "test:local-services": "node scripts/local-services-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@livekit/protocol": "^1.52.1",
    "@prometheus-io/client": "^0.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "openai": "^7.32.0",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/mcp": "^0.0.83",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.7",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
