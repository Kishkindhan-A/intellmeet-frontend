# Run `npm run setup` to generate .env and local media configuration with random secrets.
NODE_ENV=development
PORT=4000
BIND_ADDRESS=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
MAINTENANCE_MODE=false
MAINTENANCE_RETRY_SECONDS=300
# Optional monitored mailto: address or HTTPS disclosure form, plus future ISO expiry (within one year).
SECURITY_CONTACT=
SECURITY_CONTACT_EXPIRES=
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet?replicaSet=rs0&directConnection=true
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
JWT_SECRET=REPLACE_JWT_SECRET
ENCRYPTION_KEY=REPLACE_ENCRYPTION_KEY
METRICS_TOKEN=REPLACE_METRICS_TOKEN
ACCESS_TOKEN_SECONDS=600
JWT_ISSUER=intellmeet
JWT_AUDIENCE=intellmeet-api
SESSION_DAYS=7
# Local project: email/password signup works immediately. Production must set this to true.
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_ADMIN_MFA=false
LOG_LEVEL=info
SMTP_URL=smtp://127.0.0.1:1025
# All recipients use this sender's SMTP service. There is no personal-address override.
# Gmail option (eligible sender accounts only): use an App Password, URL-encode username/password.
# SMTP_URL=smtps://YOUR_SENDER%40gmail.com:YOUR_URL_ENCODED_APP_PASSWORD@smtp.gmail.com:465
# Production transactional SMTP option:
# SMTP_URL=smtps://YOUR_SMTP_USERNAME:YOUR_URL_ENCODED_SMTP_PASSWORD@smtp.example.com:465
EMAIL_FROM=IntellMeet <no-reply@localhost>
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_JOBS_PER_WORKSPACE_DAY=100
MAX_AUDIO_BYTES=24000000
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=REPLACE_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_LIVEKIT_API_SECRET
LIVEKIT_CLOUD=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intellmeet
S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
